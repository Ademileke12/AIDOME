rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is an admin
    // Note: For production, admin emails should be stored in Firestore or Firebase Functions
    // This is a simplified version for development
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email in [
               'samuelabudu21@gmail.com'
               // Add more admin emails here as needed
             ];
    }
    
    // Rules for designs collection
    match /designs/{designId} {
      allow read: if true; // Public read access for home page preview
      allow write: if isAdmin();
    }
    
    // Rules for cinematics collection
    match /cinematics/{cinematicId} {
      allow read: if true; // Public read access for home page preview
      allow write: if isAdmin();
    }
    
    // Rules for courses collection
    match /courses/{courseId} {
      allow read: if true; // Public read access for home page preview
      allow write: if isAdmin();
    }
    
    // Rules for courseAccess collection
    match /courseAccess/{accessId} {
      // Users can read their own purchases
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      // Admins can read all purchases
      allow read: if isAdmin();
      // Only admins can write (users cannot write directly)
      allow write: if isAdmin();
    }
    
    // Rules for comments collection
    match /comments/{commentId} {
      // All authenticated users can read all comments
      allow read: if isAuthenticated();
      
      // Authenticated users can create comments
      // Validate that required fields are present and userId matches auth
      allow create: if isAuthenticated() && 
                       request.resource.data.keys().hasAll(['courseId', 'userId', 'userName', 'userPhotoURL', 'text', 'timestamp']) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.text is string &&
                       request.resource.data.text.size() > 0 &&
                       request.resource.data.text.size() <= 1000;
      
      // Users can delete only their own comments
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
      
      // Admins can delete any comment
      allow delete: if isAdmin();
    }
  }
}
